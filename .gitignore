# ===================================================================
# ProjectKit Global .gitignore
# Covers Frontend (React/Vite/Node) and Backend (Spring Boot/Maven)
# ===================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
dist-ssr/
build/
target/
*.war
*.jar
*.ear

# Environment & Secrets (NEVER commit secrets or production credentials)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
!*.env.production.example

# Local Uploads & Static Binary Archives
uploads/
*.zip
*.tar.gz
*.pdf

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Configurations
# Eclipse
.project
.classpath
.settings/
.factorypath
bin/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project

# Temporary & Cache Files
.cache/
.vite/
.eslintcache
.stylelintcache
tmp/
temp/

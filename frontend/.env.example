# ===================================================================
# ProjectKit Frontend (.env.example)
# Instructions: Copy this file to '.env' in your local environment.
# Note: Variables prefixed with 'VITE_' are exposed to the client bundle.
# NEVER put private API secrets, database passwords, or JWT secrets here.
# ===================================================================

# AI Studio runtime keys (auto-injected in cloud environment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"

# Backend API Base URL
# - Development: http://localhost:8081 (or leave blank to use the Vite reverse proxy /api)
# - Production: https://api.yourdomain.com
VITE_API_BASE_URL="http://localhost:8081"

# Razorpay Publishable Test Key ID (Only the Key ID, NEVER the Key Secret!)
# Obtain from https://dashboard.razorpay.com/#/app/keys in Test Mode
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder_key"

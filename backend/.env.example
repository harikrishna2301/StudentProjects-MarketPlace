# ===================================================================
# ProjectKit Spring Boot Backend (.env.example)
# Instructions: Copy this file to 'backend/.env' or inject into your
# IDE Run Configuration / Environment Variables.
#
# SECURITY WARNING:
# NEVER commit the filled '.env' file to Git.
# ===================================================================

# Server Port
PORT=8081

# Active Spring Profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Connection
# Windows Local: jdbc:mysql://localhost:3306/projectkit_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_URL=jdbc:mysql://localhost:3306/projectkit_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT 256-bit Secret Key (Minimum 64 hex characters / 256 bits)
# Generated via: openssl rand -hex 32
JWT_SECRET=9a4f2c8d3b7a1e6f5c8d2e4a7b9c1d3e5f7a9b1c3d5e7f9a1b3c5d7e9f1a3b5c
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Razorpay Payment Gateway Credentials (Test Mode)
# Obtain from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_YourRazorpayKeyId
RAZORPAY_KEY_SECRET=YourRazorpaySecretKey
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecret

# Transactional Email Provider (SMTP / SendGrid / AWS SES)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@projectkit.dev
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=noreply@projectkit.dev

# Storage Deliverables Directory
# Windows: C:/projectkit/uploads
# Linux/macOS: /var/projectkit/uploads
STORAGE_UPLOAD_DIR=./uploads

# CORS Allowed Frontend Origins (Comma separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173

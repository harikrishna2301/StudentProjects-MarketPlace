# ===================================================================
# ProjectKit Production Frontend Environment Variables (Netlify / Vercel)
# ===================================================================

# Production backend API base URL
VITE_API_BASE_URL="https://api.projectkit.in"

# Razorpay Production Key ID (Public key for checkout modal, e.g. rzp_live_...)
VITE_RAZORPAY_KEY_ID="rzp_live_your_actual_key_here"

# Application public URL for canonical meta tags & social share cards
VITE_APP_URL="https://projectkit.in"
